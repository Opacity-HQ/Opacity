# Copy to .env.local (git-ignored) and fill in real values.
# Get these from the Supabase dashboard: Project Settings -> API.
# See backend/backend.md "Environment & Secrets" before touching the
# service role key.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret. Bypasses Row Level Security. Server-only — see
# lib/supabase/admin.ts. Never import it into a Client Component. Never
# commit it, log it, or paste it into chat/PRs/issues.
SUPABASE_SERVICE_ROLE_KEY=
